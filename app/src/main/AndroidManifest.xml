<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local filesystem first. INTERNET exists solely for update checks
         (a silent once-per-launch GitHub releases check + the user-initiated
         "Check for updates" flow and its APK download) — no periodic network,
         analytics or telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.8.1: with minSdk 34 (Android 14) the legacy READ/WRITE_EXTERNAL_STORAGE
         permissions and requestLegacyExternalStorage are obsolete — "All files access"
         (MANAGE_EXTERNAL_STORAGE) is the one permission this app needs. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Needed so tapping an APK can hand it to the system package installer.
         Android still asks the user to allow installs from this app first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

