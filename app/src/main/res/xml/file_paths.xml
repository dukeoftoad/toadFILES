<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Primary shared storage, e.g. /storage/emulated/0 -->
    <external-path name="external_storage" path="." />
    <files-path name="internal_files" path="." />
    <cache-path name="cache" path="." />
    <!-- Catch-all for everything outside the primary volume: SD cards and OTG drives
         live under /storage/XXXX-XXXX, and without this FileProvider throws
         "Failed to find configured root" the moment a user taps a file there. The
         provider is not exported and hands out read grants per-intent only, so the
         wide root is contained to apps the user explicitly shares/opens with.
         Policy: the wide root stays, but URI generation is guarded by a canonical
         ALLOWLIST (util/UriGuard.isShareablePath) — only paths that canonicalize
         under real shared-storage volumes (/storage/emulated/N, /storage/XXXX-XXXX)
         are ever handed out, and the app-private Android/data & Android/obb trees
         are refused, so symlinks and dot-segment aliases cannot smuggle private or
         system files to other apps (audit P1.1). -->
    <root-path name="device_root" path="." />
</paths>
